# =============================================================================
#  Variables de entorno — copiar a .env para desarrollo local y cargarlas en
#  Vercel (Project Settings → Environment Variables) para producción.
#
#  IMPORTANTE: ninguna de estas variables lleva el prefijo PUBLIC_, así que
#  Astro NUNCA las incluye en el bundle del navegador. Viven sólo en el
#  servidor, dentro de la función /api/rsvp.
# =============================================================================

# URL de la aplicación web publicada desde Google Apps Script.
# Se obtiene en: Apps Script → Implementar → Nueva implementación →
# Aplicación web → "Copiar URL". Termina en /exec
RSVP_ENDPOINT_URL=""

RSVP_SHARED_SECRET=""
