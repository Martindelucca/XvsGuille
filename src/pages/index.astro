---
import BaseLayout from '@/layouts/BaseLayout.astro';
import OpeningOverlay from '@/components/OpeningOverlay.astro';
import Hero from '@/components/Hero.astro';
import Countdown from '@/components/Countdown.astro';
import Agenda from '@/components/Agenda.astro';
import Location from '@/components/Location.astro';
import DressCode from '@/components/DressCode.astro';
import Rsvp from '@/components/Rsvp.astro';
import PhotoAlbum from '@/components/PhotoAlbum.astro';
import Closing from '@/components/Closing.astro';
import FloatingCta from '@/components/FloatingCta.astro';
import MusicToggle from '@/components/MusicToggle.astro';
import { sections, firstSectionId } from '@/data/event.config';
---

<BaseLayout>
  <a class="skip-link" href={`#${firstSectionId()}`}>Ir al contenido</a>

  <OpeningOverlay />

  <main>
    <Hero />
    {sections.countdown && <Countdown />}
    {sections.agenda && <Agenda />}
    {sections.location && <Location />}
    {sections.dressCode && <DressCode />}
    <Rsvp />
    {sections.photos && <PhotoAlbum />}
  </main>

  <Closing />

  <FloatingCta />
  {sections.music && <MusicToggle />}
</BaseLayout>

<script>
  import '@/lib/main';
</script>
