---
import Rule from './ornaments/Rule.astro';
import { event } from '@/data/event.config';
import { copy } from '@/data/copy';
---

<!-- Sin <h2>: el texto es un mensaje, no un título. Un párrafo largo marcado
     como encabezado ensucia el índice de los lectores de pantalla. -->
<section class="section section--paper grain intro" id="historia" aria-label="Mensaje de Guille">
  <div class="wrap wrap--narrow stack">
    <p class="label" data-reveal="0">{copy.intro.label}</p>

    <p class="lead intro__text" data-reveal="1">{copy.intro.text}</p>

    <span class="intro__rule" data-reveal="2">
      <Rule width="110px" />
    </span>

    <div class="intro__signature" data-reveal="3">
      <p class="intro__name">{event.celebrant}</p>
      <p class="data intro__date">{event.displayDate}</p>
    </div>
  </div>
</section>

<style>
  .intro__text {
    margin-block-start: var(--s-6);
    color: var(--c-on-light);
  }

  .intro__rule {
    display: block;
    margin-block-start: var(--s-8);
    color: var(--c-on-light-faint);
  }

  .intro__signature {
    margin-block-start: var(--s-8);
  }

  .intro__name {
    font-family: var(--f-display);
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--c-navy);
  }

  .intro__date {
    margin-block-start: var(--s-3);
    color: var(--c-on-light-muted);
  }
</style>
