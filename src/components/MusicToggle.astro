---
import { event } from '@/data/event.config';
import { copy } from '@/data/copy';
---

<div class="music">
  <audio
    src={event.musicUrl}
    loop
    preload="none"
    data-music-audio
    data-volume={String(event.musicVolume)}></audio>

  <button
    type="button"
    class="music__toggle"
    data-music-toggle
    data-playing="false"
    data-label-on={copy.music.on}
    data-label-off={copy.music.off}
    aria-pressed="false"
    aria-label={copy.music.off}
  >
    <span class="music__bars" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    <span class="music__text">{copy.music.label}</span>
  </button>
</div>

<style>
  .music {
    position: fixed;
    inset-block-end: max(var(--s-4), env(safe-area-inset-bottom));
    inset-inline-start: var(--gutter);
    z-index: var(--z-float);
  }

  .music__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-block-size: 44px;
    padding: var(--s-2) var(--s-4);
    border-radius: var(--r-pill);
    background-color: color-mix(in srgb, var(--c-navy-deep) 80%, transparent);
    backdrop-filter: blur(10px);
    color: var(--c-blue-light);
    font-size: 0.625rem;
    letter-spacing: var(--ls-wide);
    text-indent: var(--ls-wide);
    text-transform: uppercase;
    transition: color var(--d-micro) var(--e-out);
  }

  .music__bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    block-size: 12px;
    text-indent: 0;
  }

  .music__bars span {
    inline-size: 2px;
    block-size: 30%;
    background: currentColor;
    transition: block-size var(--d-micro) var(--e-out);
  }

  [data-playing='true'] .music__bars span {
    animation: eq 1.1s var(--e-in-out) infinite;
  }

  [data-playing='true'] .music__bars span:nth-child(2) {
    animation-delay: 180ms;
  }

  [data-playing='true'] .music__bars span:nth-child(3) {
    animation-delay: 360ms;
  }

  @keyframes eq {
    0%,
    100% {
      block-size: 30%;
    }
    50% {
      block-size: calc(30% + 70% * var(--motion));
    }
  }

  /* El texto es ruido en pantallas chicas: quedan las barras + aria-label */
  @media (max-width: 429px) {
    .music__text {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
