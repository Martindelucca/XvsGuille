---
/**
 * Íconos de línea, inline y sin librería externa.
 * Sólo los cinco que la invitación necesita: nada de un paquete de 400 KB.
 */
interface Props {
  name: 'pin' | 'camera' | 'calendar' | 'note' | 'arrow';
  class?: string;
  size?: number;
  [key: string]: unknown;
}
const { name, class: className = '', size = 18, ...rest } = Astro.props;

const paths: Record<Props['name'], string> = {
  pin: '<path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/>',
  camera:
    '<path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h2.2l1.2-2h8.2l1.2 2h2.2A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5v-9Z"/><circle cx="12" cy="13" r="3.8"/>',
  calendar:
    '<rect x="3.5" y="5.5" width="17" height="15" rx="1.5"/><path d="M3.5 10h17M8 3.5v4M16 3.5v4"/>',
  note: '<path d="M5 4.5h14v15H5z"/><path d="M8.5 9h7M8.5 12.5h7M8.5 16h4"/>',
  arrow: '<path d="M12 4v16M6 14l6 6 6-6"/>',
};
---

<svg
  class={`icon ${className}`}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
  set:html={paths[name]}
/>

<style>
  .icon {
    flex: none;
    display: block;
  }
</style>
